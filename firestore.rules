rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 관리자 이메일 체크 함수
    function isAdmin() {
      return request.auth != null && request.auth.token.email in [
        'playjaehoon@gmail.com',
        'aay0909@hufs.ac.kr',
        'ddaltwo9@gmail.com'
      ];
    }

    // 사용자 문서
    match /users/{userId} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if (request.auth != null && request.auth.uid == userId) || isAdmin();
      allow delete: if isAdmin(); // 관리자만 삭제 가능
    }

    // 스캔 기록
    match /users/{userId}/scans/{scanId} {
      allow read:   if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update, delete: if false;
    }

    // 걷기 인증 (관리자 3명만 읽기, 업데이트, 삭제가 가능하도록 수정)
    match /users/{userId}/proofs/{proofId} {
      allow read:   if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin(); // 관리자 3명만 삭제(취소/초기화) 가능
    }

    // 달성 현황 페이지용
    match /users/{userId} {
      allow read: if request.auth != null;
    }

    // 대조군
    match /control_group/{docId} {
      allow create, read: if true;
      allow update, delete: if isAdmin();
    }

    // 학부 소식 (notices) 추가!
    match /notices/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 학부 일정 (events) 추가!
    match /events/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
